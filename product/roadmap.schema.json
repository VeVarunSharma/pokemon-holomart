{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-desk.invalid/schemas/roadmap.schema.json",
  "title": "Signal Desk roadmap",
  "description": "Schema for the synthetic, authoritative Signal Desk roadmap artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "metadata", "horizons", "initiatives"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./roadmap.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "title", "updatedAt", "authoritative", "provenance", "sources"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "authoritative": { "type": "boolean", "const": true },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "description", "limitations"],
          "properties": {
            "label": { "type": "string", "const": "SYNTHETIC / DEMO-ONLY" },
            "description": { "type": "string", "minLength": 1 },
            "limitations": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "horizons": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/horizon" }
    },
    "initiatives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/initiative" }
    }
  },
  "$defs": {
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "order", "definition"],
      "properties": {
        "id": { "enum": ["now", "next", "later"] },
        "label": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "definition": { "type": "string", "minLength": 1 }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "outcome",
        "horizon",
        "status",
        "confidence",
        "impact",
        "effort",
        "targetWindow",
        "ownerRole",
        "dependencies",
        "evidenceReferences",
        "evidenceCount",
        "risks",
        "humanDecisionFlags",
        "successMeasures",
        "issueDraft"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^init-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "horizon": { "enum": ["now", "next", "later"] },
        "status": {
          "enum": ["discovery", "planned", "in-progress", "gated", "candidate"]
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "impact": { "enum": ["low", "medium", "high"] },
        "effort": { "enum": ["small", "medium", "large", "unknown"] },
        "targetWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "start", "end"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "start": {
              "anyOf": [
                { "type": "string", "format": "date" },
                { "type": "null" }
              ]
            },
            "end": {
              "anyOf": [
                { "type": "string", "format": "date" },
                { "type": "null" }
              ]
            }
          }
        },
        "ownerRole": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidenceReferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceReference" }
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 0,
          "$comment": "Must equal evidenceReferences.length; checked by consuming scripts."
        },
        "risks": {
          "type": "array",
          "items": { "$ref": "#/$defs/risk" }
        },
        "humanDecisionFlags": {
          "type": "array",
          "items": { "$ref": "#/$defs/humanDecision" }
        },
        "successMeasures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/successMeasure" }
        },
        "issueDraft": { "$ref": "#/$defs/issueDraft" }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "summary"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(CI|SS|AN|MK)-[0-9]{2}$"
        },
        "type": {
          "enum": ["customer-interview", "support-signal", "usage-analytics", "market-note"]
        },
        "path": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "likelihood", "impact", "mitigation"],
      "properties": {
        "id": { "type": "string", "pattern": "^risk-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": { "type": "string", "minLength": 1 },
        "likelihood": { "enum": ["low", "medium", "high", "unknown"] },
        "impact": { "enum": ["low", "medium", "high", "unknown"] },
        "mitigation": { "type": "string", "minLength": 1 }
      }
    },
    "humanDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "requiredBy", "status", "options"],
      "properties": {
        "id": { "type": "string", "pattern": "^decision-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "question": { "type": "string", "minLength": 1 },
        "requiredBy": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "decided", "deferred"] },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "successMeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "criterion", "source", "guardrail"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "criterion": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "guardrail": { "type": "boolean" }
      }
    },
    "issueDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "labels", "childWorkItems"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "childWorkItems": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/childWorkItem" }
        }
      }
    },
    "childWorkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "acceptanceCriteria", "dependencies"],
      "properties": {
        "id": { "type": "string", "pattern": "^work-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
