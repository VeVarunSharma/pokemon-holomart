{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "HoloMart synthetic demo tokens",
  "provenance": "SYNTHETIC / DEMO-ONLY",
  "color": {
    "surface": {
      "canvas": { "$type": "color", "$value": "#F6F7FB" },
      "panel": { "$type": "color", "$value": "#FFFFFF" },
      "subtle": { "$type": "color", "$value": "#F1F3F9" },
      "inverse": { "$type": "color", "$value": "#111936" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#171A2B" },
      "secondary": { "$type": "color", "$value": "#686D7E" },
      "inverse": { "$type": "color", "$value": "#FFFFFF" },
      "link": { "$type": "color", "$value": "#5850EC" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#CBD2DC" },
      "strong": { "$type": "color", "$value": "#667085" },
      "focus": { "$type": "color", "$value": "#5850EC" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "#5850EC" },
      "primaryHover": { "$type": "color", "$value": "#443BD4" },
      "danger": { "$type": "color", "$value": "#B42318" }
    },
    "status": {
      "success": { "$type": "color", "$value": "#18794E" },
      "warning": { "$type": "color", "$value": "#8A4B08" },
      "error": { "$type": "color", "$value": "#B42318" },
      "info": { "$type": "color", "$value": "#175CD3" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "medium": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "large": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "pill": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Inter, Segoe UI, system-ui, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "Cascadia Code, Consolas, monospace"
      }
    },
    "size": {
      "small": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "body": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
      "title": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
      "display": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 100, "unit": "ms" } },
    "standard": { "$type": "duration", "$value": { "value": 180, "unit": "ms" } }
  },
  "layout": {
    "contentMax": { "$type": "dimension", "$value": { "value": 1440, "unit": "px" } },
    "sidebar": { "$type": "dimension", "$value": { "value": 248, "unit": "px" } },
    "controlHeight": { "$type": "dimension", "$value": { "value": 36, "unit": "px" } },
    "touchTargetPreferred": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } }
  }
}
